<Window
    x:Class="SnipPlus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="CommandBar" Padding="24" Spacing="10">
            <TextBlock FontSize="28" Text="SnipPlus" />
            <TextBlock Text="First vertical slice" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="StartCaptureButton" Click="StartCaptureButton_Click" Content="Start Capture" />
                <CheckBox
                    x:Name="PrintScreenTakeoverCheckBox"
                    AutomationProperties.Name="PrintScreen takeover"
                    Click="PrintScreenTakeoverCheckBox_Click"
                    Content="Take over PrintScreen"
                    IsThreeState="False" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Ready" />
            </StackPanel>
            <TextBlock
                x:Name="PrintScreenCompatibilityNoticeText"
                TextWrapping="Wrap" />
            <Button
                x:Name="OpenWindowsKeyboardSettingsButton"
                AutomationProperties.Name="Open Windows keyboard settings"
                Click="OpenWindowsKeyboardSettingsButton_Click" />
        </StackPanel>

        <Grid Grid.Row="1" Padding="24">
            <TextBlock Text="Capture is started explicitly by Start Capture or PrintScreen." />
        </Grid>
    </Grid>
</Window>
